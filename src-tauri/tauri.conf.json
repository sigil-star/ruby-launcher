{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ruby Launcher",
  "version": "1.0.11",
  "identifier": "com.rubylauncher.tauri",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Ruby Launcher",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "visible": false,
        "center": true,
        "backgroundColor": "#0c0c0c"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https: asset: http://asset.localhost; media-src 'self' data: blob: https:; font-src 'self' data: asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost data: blob: https://*.roblox.com https://*.rbxcdn.com; worker-src 'self' blob:; frame-src https://*.roblox.com; object-src 'none'; base-uri 'self'; form-action 'none'",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerHooks": "./installer/hooks.nsh",
        "sidebarImage": "./installer/sidebar.bmp",
        "headerImage": "./installer/header.bmp",
        "installerIcon": "./icons/icon.ico",
        "compression": "lzma"
      }
    },
    "externalBin": [],
    "resources": [],
    "copyright": "Ruby Launcher is not affiliated with, endorsed by, or sponsored by Roblox Corporation.",
    "licenseFile": "../LICENSE"
  },
  "plugins": {}
}
